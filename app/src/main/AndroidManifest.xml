<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />

    <application
        android:name=".core.PrestaFlowApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrestaFlow"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PrestaFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link pour les notifications "nouvelle commande" / statut / expédition.
                 La notification foreground (ContentIntent) envoie prestaflow://orders/{id} ;
                 le tap déclenche onNewIntent (singleTop) ou onCreate (cold start) dans MainActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="prestaflow"
                    android:host="orders" />
            </intent-filter>
            <!-- Deep link pour les notifications "stock faible" (event = stock.low).
                 La notification foreground (ContentIntent) envoie prestaflow://products/{id} ;
                 le tap déclenche onNewIntent (singleTop) ou onCreate (cold start) dans MainActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="prestaflow"
                    android:host="products" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.push.PrestaFlowFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Notifs background sans channel_id explicite → canal sobre (son système, pas la caisse).
             Le module envoie le channel_id explicite pour les 3 catégories ; ceci n'est qu'un filet.
             Le canal est créé dans PrestaFlowApp via NotificationChannels.ensureAllChannels. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Scan QR verrouillé en portrait (la CaptureActivity ZXing par défaut force le paysage). -->
        <activity
            android:name=".ui.auth.PortraitCaptureActivity"
            android:screenOrientation="sensorPortrait"
            android:stateNotNeeded="true"
            android:exported="false"
            android:theme="@style/zxing_CaptureTheme" />

        <!-- FileProvider pour partager des PDFs (bordereau, facture) via Intent.ACTION_SEND.
             L'autorité utilise l'applicationId du flavor actif (prod / preprod / debug). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Sélecteur de langue in-app (Réglages) — API AndroidX per-app language.
             Sur API < 33, ce service déclenche la persistance automatique (SharedPreferences
             internes à AppCompat) de la langue choisie via AppCompatDelegate.setApplicationLocales.
             Sur API 33+, la plateforme (LocaleManager) persiste elle-même ; ce service reste sans
             effet mais n'est pas nuisible. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
